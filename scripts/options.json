 {"key":"bit-rate","type":"int","label":"Qualidade do vídeo","choices":[[4,"4 Mbps (economiza rede)"],[8,"8 Mbps (padrão)"],[16,"16 Mbps"],[32,"32 Mbps"]]},
 {"key":"audio","type":"bool","label":"Encaminhar o áudio do celular (Android 11+)"},
