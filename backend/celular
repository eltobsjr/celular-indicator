#!/usr/bin/env python3
"""celular — espelha o celular Android via Wi-Fi com scrcpy (versão de terminal).

Uso:
  celular                 conecta (pareando por QR code se preciso) e abre o scrcpy
  celular --parear        força um novo pareamento por QR code
  celular --codigo        pareamento manual (IP:porta + código de 6 dígitos)
  celular --diagnostico   explica por que o celular não conecta
  celular --info          mostra o último celular pareado
  celular --sair          desconecta o celular (não mexe no servidor adb)
  celular [opções...]     qualquer outra opção vai direto para o scrcpy

O scrcpy roda num escopo systemd com limite de memória/CPU e só com a GPU integrada
(Mesa), as mesmas proteções da extensão. CELULAR_SEM_LIMITES=1 desliga isso.
"""
import json
import os
import random
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import celular_lib as lib  # noqa: E402

QR_TIMEOUT = 120
SAFE_DEFAULTS = ["--max-size=1280", "--max-fps=60", "--render-driver=opengl", "--no-audio"]


def render_qr(text):
    """Desenha o QR com fundo branco fixo (funciona em qualquer tema de terminal)."""
    import segno  # só carrega quando há QR pra desenhar
    m = [list(row) for row in segno.make(text, error="m", micro=False).matrix]
    q = 4  # zona de silêncio
    w = len(m[0]) + 2 * q
    grid = [[0] * w for _ in range(q)]
    grid += [[0] * q + row + [0] * q for row in m]
    grid += [[0] * w for _ in range(q)]
    if len(grid) % 2:
        grid.append([0] * w)
    glyph = {(0, 0): " ", (1, 1): "█", (1, 0): "▀", (0, 1): "▄"}
    lines = []
    for y in range(0, len(grid), 2):
        row = "".join(glyph[(grid[y][x], grid[y + 1][x])] for x in range(w))
        lines.append("  \033[47;30m" + row + "\033[0m")
    print("\n".join(lines))


def online_serial():
    d = lib.pick_device(lib.parse_devices(lib.adb("devices", "-l").out), lib.load_device())
    return d["serial"] if d else None


def wait_connect(hint_ip=None, timeout=20):
    """Espera o celular ficar online; tenta 'adb connect' nos serviços descobertos."""
    last = lib.load_device()
    end = time.time() + timeout
    tried = set()
    while time.time() < end:
        serial = online_serial()
        if serial:
            return serial
        for name, kind, addr in lib.parse_mdns(lib.adb("mdns", "services", timeout=5).out):
            if not kind.startswith("_adb-tls-connect") or addr in tried:
                continue
            if hint_ip and not addr.startswith(hint_ip + ":"):
                continue
            tried.add(addr)
            ok, code = lib.classify_connect(lib.adb("connect", addr, timeout=8).out)
            if not ok:
                print(f"  {addr}: {lib.error_info(code)['text']}")
        time.sleep(1.5)
    return online_serial()


def pair_qr():
    name = "celular-%04d" % random.randint(0, 9999)
    password = "%06d" % random.randint(0, 999999)
    print("\nNo celular: Configurações → Opções do desenvolvedor → Depuração por Wi-Fi")
    print("→ \"Parear o dispositivo com um QR code\" e aponte a câmera aqui:\n")
    render_qr(f"WIFI:T:ADB;S:{name};P:{password};;")
    print(f"\nAguardando o celular escanear (até {QR_TIMEOUT}s, Ctrl+C cancela)...")
    end = time.time() + QR_TIMEOUT
    while time.time() < end:
        for svc, kind, addr in lib.parse_mdns(lib.adb("mdns", "services", timeout=5).out):
            if kind.startswith("_adb-tls-pairing") and svc == name:
                print(f"Celular encontrado em {addr}, pareando...")
                res = lib.adb("pair", addr, password, timeout=20)
                print(res.out)
                return addr.rsplit(":", 1)[0] if not lib.classify_pair(res.out) else None
        time.sleep(1)
    print("Tempo esgotado sem ninguém escanear o QR.")
    return None


def pair_manual():
    print("\nNo celular: Depuração por Wi-Fi → \"Parear o dispositivo com um código de pareamento\"")
    print("(deixe essa tela aberta até terminar)")
    code = input("Código de 6 dígitos: ").strip()
    if not lib.valid_pair_code(code):
        explain("pair_code_invalid")
        return None
    print("Procurando o celular na rede...")
    addr = None
    end = time.time() + 8
    while not addr and time.time() < end:
        addr = lib.pick_pairing_service(lib.parse_mdns(lib.adb("mdns", "services", timeout=5).out))
        if not addr:
            time.sleep(1)
    if addr:
        print(f"Celular encontrado em {addr}.")
    else:
        addr = lib.normalize_pair_addr(input("IP:porta do pareamento (mostrado no celular): "))
        if not addr:
            explain("pair_code_invalid")
            return None
    res = lib.adb("pair", addr, code, timeout=20)
    print(res.out)
    err = lib.classify_pair(res.out, by_code=True)
    if err:
        explain(err)
        return None
    return addr.rsplit(":", 1)[0]


def explain(code):
    info = lib.error_info(code)
    print(f"\n✗ {info['text']}\n  → {info['hint']}")


def diagnostico():
    backend = os.path.join(HERE, "celular-backend")
    proc = subprocess.Popen([sys.executable, backend, "diagnose"], stdout=subprocess.PIPE, text=True)
    icons = {"ok": "✓", "warn": "!", "error": "✗"}
    for line in proc.stdout:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("event") == "check":
            print(f" {icons.get(msg['level'], '-')} {msg['text']}")
        elif msg.get("event") == "diagnosis":
            print(f"\n{msg['text']}")
            if msg.get("hint"):
                print(f"  → {msg['hint']}")
    return proc.wait()


def scoped(cmd):
    """Prefixa o comando com systemd-run (escopo com limites), se disponível."""
    if os.environ.get("CELULAR_SEM_LIMITES") or not shutil.which("systemd-run"):
        return cmd
    return ["systemd-run", "--user", "--scope", "--quiet", "--collect",
            f"--unit=celular-cli-{os.getpid()}", "-p", "MemoryMax=1536M", "-p", "MemorySwapMax=0",
            "-p", "CPUQuota=300%", "-p", "TasksMax=256", "--", "nice", "-n", "5"] + cmd


def main():
    args = sys.argv[1:]

    if args[:1] in (["-h"], ["--help"], ["--ajuda"]):
        print(__doc__)
        return 0
    if args[:1] == ["--diagnostico"]:
        return diagnostico()
    if args[:1] == ["--info"]:
        last = lib.load_device()
        print(json.dumps(last, ensure_ascii=False, indent=2) if last else "Nenhum celular pareado ainda.")
        return 0

    res = lib.adb("start-server", timeout=30)
    code = lib.classify_server(res)
    if code:
        explain(code)
        return 1

    if args[:1] == ["--sair"]:
        last = lib.load_device()
        target = (last or {}).get("serial")
        print(lib.adb("disconnect", *([target] if target else [])).out)
        return 0

    force = args[:1] in (["--parear"], ["--codigo"])
    serial = None if force else online_serial()
    if not force and not serial:
        # Celulares já pareados aparecem sozinhos via mDNS quando estão na mesma rede.
        print("Procurando celular já pareado na rede...")
        serial = wait_connect()
        if not serial:
            if lib.load_device():
                code, _ = lib.diagnose_unreachable(lib.load_device())
                explain(code)
                print("\nPara parear de novo: celular --parear")
                return 1
            print("Nenhum celular pareado encontrado — vamos parear.")
            force = True

    if force:
        try:
            ip = pair_manual() if args[:1] == ["--codigo"] else pair_qr()
        except KeyboardInterrupt:
            print("\nCancelado.")
            return 1
        if not ip:
            print("Pareamento não concluído.")
            return 1
        print("Pareado! Conectando...")
        serial = wait_connect(ip)
        if not serial:
            explain("connect_failed")
            return 1
        lib.save_device({"serial": serial, "paired_at": int(time.time())})

    if args[:1] in (["--parear"], ["--codigo"]):
        args = args[1:]
    info = lib.device_info(serial) or {}
    lib.save_device({"serial": serial, "connected_at": int(time.time()), **info})
    print(f"Conectado a {info.get('name') or serial}. Abrindo espelhamento...")
    user_flags = {a.split("=")[0] for a in args}
    extra = [d for d in SAFE_DEFAULTS if d.split("=")[0] not in user_flags
             and not (d == "--no-audio" and "--audio" in user_flags)]
    args = [a for a in args if a != "--audio"]
    env = lib.gpu_safe_env(lib.adb_env())
    try:
        return subprocess.call(scoped([lib.scrcpy_path(), "-s", serial, "--stay-awake", *extra, *args]), env=env)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
